# ==========================================
# MERCADO PAGO — PRODUCCIÓN (ARGENTINA)
# ==========================================

MP_PUBLIC_KEY=TU_PUBLIC_KEY_DE_PRODUCCION
MP_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_PRODUCCION
MP_CLIENT_ID=TU_CLIENT_ID
MP_CLIENT_SECRET=TU_CLIENT_SECRET


# ==========================================
# PAYPAL CHECKOUT — LIVE (EXTERIOR)
# ==========================================

PAYPAL_CLIENT_ID=TU_PAYPAL_CLIENT_ID_LIVE
PAYPAL_CLIENT_SECRET=TU_PAYPAL_CLIENT_SECRET_LIVE
PAYPAL_ENVIRONMENT=live


# ==========================================
# CONVERSIÓN DE PRECIOS EXTERIORES
# ==========================================

# Cantidad de pesos argentinos equivalente a USD 1.
# Ejemplo: si USD 1 = ARS 1400:
ARS_PER_USD=1400


# ==========================================
# SERVIDOR LOCAL
# ==========================================

PORT=3000
PUBLIC_URL=http://localhost:3000
NODE_ENV=development


